# SquadSpot backend – environment variables
# Copy this file to .env and set values for your environment.
# Do not commit .env (it should be in .gitignore).

# -----------------------------------------------------------------------------
# Database (SQLite file path; relative to project root or absolute)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./squadspot.db

# -----------------------------------------------------------------------------
# Optional: environment name (development, staging, production)
# -----------------------------------------------------------------------------
ENV=development
